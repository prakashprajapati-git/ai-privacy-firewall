{
  "manifest_version": 3,
  "name": "AI Privacy Firewall",
  "version": "1.0.0",
  "description": "Local-first privacy firewall preventing sensitive data, credentials, PII, and financial information from leaking to AI websites.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://claude.ai/*",
    "*://copilot.microsoft.com/*",
    "*://*.bing.com/*",
    "*://www.perplexity.ai/*",
    "*://chat.deepseek.com/*",
    "*://grok.com/*",
    "*://x.ai/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "AI Privacy Firewall",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*",
        "*://copilot.microsoft.com/*",
        "*://*.bing.com/*",
        "*://www.perplexity.ai/*",
        "*://chat.deepseek.com/*",
        "*://grok.com/*",
        "*://x.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
